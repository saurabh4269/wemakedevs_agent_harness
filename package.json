{
  "name": "loop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LOOP \u2014 one TrueForge product-investigation agent for the WeMakeDevs Agent Harness Hackathon",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json",
    "test": "vitest run && npm test -w loop-ui",
    "demo:voiceover": "npm run voiceover -w loop-demo",
    "demo:render": "npm run render -w loop-demo",
    "fixture:mcp": "tsx fixtures/mcp/server.ts",
    "import:loop": "tsx scripts/import-loop.ts",
    "ui": "npm run dev -w loop-ui",
    "ui:build": "npm run build -w loop-ui",
    "start:hosted": "tsx scripts/start-hosted-trueforge.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@truefoundry/trueforge-sdk": "^0.1.3",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.29",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "workspaces": [
    "apps/loop-ui",
    "apps/loop-demo"
  ],
  "overrides": {
    "zustand": "^5.0.15"
  }
}
