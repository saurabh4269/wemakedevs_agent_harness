# Copy to .env locally. Never commit real keys.
# TrueForge local: npx @truefoundry/trueforge  →  http://localhost:8790
# TrueForge Compose hosted: docker compose up  →  http://localhost:8791
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_TOKEN=

# Model FQN is provider/name after you add the custom provider in Settings.
# Import script can also register the OpenRouter provider if OPENROUTER_API_KEY is set.
LOOP_MODEL_FQN=openrouter/gpt-4.1-mini

# Fixture MCP (mode:fixture). No live GitHub.
LOOP_FIXTURE_PORT=8788
LOOP_WAREHOUSE_URL=http://127.0.0.1:8788/warehouse
LOOP_GITHUB_URL=http://127.0.0.1:8788/github
# independent = seeded conversion-drop. collapsed = negative test (three restatements).
LOOP_DATASET=independent

# Skills are git-backed. Pin a branch until this lands on main.
LOOP_SKILL_REPO=https://github.com/saurabh4269/wemakedevs_agent_harness
LOOP_SKILL_REF=feat/loop-product-first

# OpenRouter — custom OpenAI-compatible provider in TrueForge Settings → Models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_ID=openai/gpt-4.1-mini
OPENROUTER_MODEL_NAME=gpt-4.1-mini

# NVIDIA NIM backup (optional). Same custom-provider shape, different base URL.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL_ID=
NVIDIA_MODEL_NAME=

# Hosted TrueForge (Compose/K8s). Local npx does not need this.
# Later public origin: https://loop.thexplorers.xyz
PUBLIC_BASE_URL=http://localhost:8791

# Daytona — TrueForge Settings → Sandbox, or import-loop if the key is set locally.
# Never commit the real key. Snapshot write permission is required.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# LOOP UI (apps/loop-ui). Empty = Vite same-origin proxy to localhost:8790.
# Direct: http://localhost:8790  Hosted: https://loop.thexplorers.xyz
VITE_TRUEFORGE_URL=
# Local TrueForge on localhost:8790 is no-login. Do not put a credential in VITE_* — Vite embeds those in the client bundle.
